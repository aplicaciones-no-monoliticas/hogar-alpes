# Copiar a `.env` y ajustar. `.env` está ignorado por git: el repositorio es
# público y no lleva credenciales (RNF-6).
#
#   cp .env.example .env
#   docker compose up -d

# --- Credenciales de las bases de datos ---------------------------------
# Las cuatro instancias usan el mismo usuario y contraseña por comodidad en
# desarrollo, pero cada servicio solo tiene red hacia LA SUYA (INF-5 · CA-T1).
# En el despliegue de AWS se generan valores distintos y no se commitean.
POSTGRES_USER=hogaralpes
POSTGRES_PASSWORD=hogaralpes

# --- Puertos de las API en el host --------------------------------------
# En macOS el 5000 lo ocupa AirPlay Receiver; por eso las API se publican
# a partir del 8000.
PUERTO_TRABAJOS=8000
PUERTO_OPERACIONES=8001
PUERTO_ACREDITACION=8002
PUERTO_EMPAREJAMIENTO=8003

# --- Opcionales ----------------------------------------------------------
# Workers de gunicorn por API.
# WORKERS=2

# Segundos entre reintentos de suscripción de los consumidores.
# ESPERA_REINTENTO=5

# Clave de admin de Grafana (--profile demo). Por defecto "hogaralpes".
# GRAFANA_PASSWORD=hogaralpes

# Solo para herramientas que corren DESDE EL HOST (spike, generador de carga,
# mediciones). Los servicios, dentro de Docker, no lo usan: ver INF-2 en
# docs/decisiones.md.
# BROKER_URL=pulsar://localhost:6650,localhost:6651
# BROKER_LISTENER=external
