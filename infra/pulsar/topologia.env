# Topología de mensajería · fuente única para inicializar.sh y agregar-region.sh
#
# Cambiar un valor aquí cambia lo que se crea en el broker. No hay nombres de
# tópico escritos en el código de los servicios: cada uno los arma a partir de
# su tenant, su namespace y su región.

CLUSTER=cluster-hda
TENANT=hogar-alpes

# Un namespace por contexto productor: cada equipo fija las políticas de sus
# propios streams.
NS_TRABAJOS=trabajos
NS_ACREDITACION=acreditacion
NS_EMPAREJAMIENTO=emparejamiento

# Regiones que se crean de entrada. `conosur` NO está: se agrega en caliente
# durante el escenario 8 (CA-8.4), para medir que las regiones activas no se
# interrumpen.
REGIONES_INICIALES="andina norteamerica"

# El paralelismo máximo por región lo fija este número: con suscripción
# Failover, una réplica por partición. Es el punto de sensibilidad del
# escenario 8, y por eso la medición va de 1 a 4 consumidores.
PARTICIONES=4

# --- Políticas de los namespaces -------------------------------------------

# La "ventana de retención" del escenario 6. En Pulsar, `retention` aplica a lo
# YA confirmado; lo no confirmado vive en el backlog hasta que se confirma,
# vence el TTL o lo desaloja la cuota. Así que la ventana la fijan TTL y cuota.
# 7 días cubre una caída de fin de semana con margen.
TTL_SEGUNDOS=604800

# Desalojar lo más viejo del backlog, NUNCA retener al productor: si la cuota
# bloqueara al productor, la caída del reactor degradaría a Gestión de Trabajos,
# que es justo lo que el escenario 6 prohíbe. El costo aceptado es perder
# eventos si la caída supera la ventana (riesgo declarado en la Entrega 3).
CUOTA_BACKLOG=10G
POLITICA_BACKLOG=consumer_backlog_eviction

# Retención de lo ya confirmado: permite re-leer para depurar. No es la ventana
# del escenario.
#
# OJO al acoplamiento: Pulsar rechaza (HTTP 412) una cuota de backlog que no sea
# ESTRICTAMENTE menor que la retención del namespace. Con retención 10G y cuota
# 10G también falla: 10G < 10G es falso. Por eso la retención se dimensiona por
# encima de la cuota, y no al revés — recortar el backlog encogería la ventana de
# la que depende el escenario 6. Y por eso `inicializar.sh` aplica la retención
# ANTES que la cuota.
RETENCION_TAMANO=20G
RETENCION_TIEMPO=1d

# Productores y consumidores se despliegan en cualquier orden (MOD-3 redespliega
# un servicio solo), y un consumidor que vuelve de una caída lee backlog escrito
# con cualquier versión de los últimos 7 días: por eso transitiva.
COMPATIBILIDAD=FULL_TRANSITIVE
